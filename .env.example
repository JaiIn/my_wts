# my_wts local environment template
# Copy this file to .env.local. Never commit .env.local.

TOSS_API_BASE_URL=https://openapi.tossinvest.com

# Leave blank until MS-04.01, immediately before the first approved live read-only call.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Live Toss read-only access. Keep false until the approved live-read stage.
ALLOW_LIVE_TOSS_API=false

# Local-only binding.
LOCAL_BIND_HOST=127.0.0.1
LOCAL_PORT=3000

# Local database and logging. Never log secrets, tokens, raw account numbers, or raw API bodies.
DATABASE_PATH=./data/my_wts.sqlite3
LOG_LEVEL=info
LOG_PATH=./logs/my_wts.log

REQUEST_TIMEOUT_GET_MS=8000
